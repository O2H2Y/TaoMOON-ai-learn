# 桃MOON智能闯关挑战小程序 - 后端环境变量示例
# 复制本文件为 .env 后，按实际环境填写配置值

# DeepSeek 配置
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Tavily 联网搜索配置（用于 AI 出题时获取最新知识）
TAVILY_API_KEY=your_tavily_api_key
ENABLE_WEB_SEARCH=true

# DashScope（百炼 Embedding，用于知识库 RAG）
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 知识库 / 向量存储配置
CHROMA_PERSIST_DIR=./data/chroma
KB_UPLOAD_DIR=./data/uploads
KB_MAX_DOCUMENTS_PER_USER=10
KB_MAX_FILE_SIZE_MB=10
KB_CHUNK_SIZE=1000
KB_CHUNK_OVERLAP=150
KB_RETRIEVE_TOP_K=4

# 题目配图（DashScope 千问-文生图 qwen-image，可与 Embedding 共用同一个百炼 API Key，
# 若该 Key 未开通 qwen-image 权限则需单独配置 DASHSCOPE_IMAGE_API_KEY）
DASHSCOPE_IMAGE_MODEL=qwen-image-2.0
DASHSCOPE_IMAGE_API_KEY=
DASHSCOPE_IMAGE_BASE_URL=
IMAGE_GEN_SIZE=512*512
IMAGE_GEN_DAILY_LIMIT=20
IMAGE_GEN_MAX_CONCURRENCY=5
# 百炼图像模型有秒级 RPS 限流（qwen-image-2.0 为 2 次/秒），必须匀速调用避免 429
IMAGE_GEN_MIN_INTERVAL_SECONDS=0.7
IMAGE_GEN_MAX_ATTEMPTS=4
IMAGE_GEN_RETRY_BASE_DELAY_SECONDS=2
IMAGE_GEN_RETRY_MAX_DELAY_SECONDS=30

# 腾讯云 COS（存储 AI 生成的题目配图、用户头像与分享小程序码）
COS_SECRET_ID=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key
COS_REGION=ap-shanghai
COS_BUCKET=your_bucket-appid
COS_UPLOAD_PREFIX=quiz-images/
COS_DOMAIN=

# 用户头像（POST /api/v1/user/avatar 的上传大小上限）
AVATAR_MAX_SIZE_MB=5

# 后端服务配置
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# MySQL 配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=yu_ai_learn
MYSQL_CHARSET=utf8mb4
MYSQL_POOL_MINSIZE=1
MYSQL_POOL_MAXSIZE=10
MYSQL_AUTO_INIT=true

# 微信小程序配置
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret

# 微信小程序分享（分享海报上的小程序码）
# 开发阶段可设为 develop（开发版）或 trial（体验版），正式上线用 release
WECHAT_MINIPROGRAM_ENV_VERSION=release
SHARE_QRCODE_PAGE=pages/share/index
SHARE_QRCODE_WIDTH=430

# 日志级别
LOG_LEVEL=INFO

# Langfuse tracing（可选；留空则不上报）
ENABLE_TRACING=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development
